# Copy to .env and fill in. Leave empty to use the offline color-matching
# fallback (the demo runs fully without a key).
#
# Nebius Token Factory key — get $25 free credit via the Nebius AI Builder
# Program. Required only for live VLM grounding (Nemotron).
NEBIUS_API_KEY=

# Vision model id on Token Factory. Verify against the current catalog
# (GET /v1/models) — ids churn. Example: nvidia/Nemotron-3.5-Super-VL
NEBIUS_VLM_MODEL=

# Token Factory base URL (OpenAI-compatible). Change only if Nebius moves it.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
